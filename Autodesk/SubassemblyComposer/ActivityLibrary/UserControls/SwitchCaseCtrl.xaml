<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Autodesk.SubassemblyComposer.ActivityLibrary.UserControls.SwitchCaseCtrl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:vb="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation" xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation" xmlns:local="clr-namespace:Autodesk.SubassemblyComposer.ActivityLibrary.UserControls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBox Name="Label" Width="120" BorderThickness="0" BorderBrush="#FFFFFFFF" Background="#FFFFFFFF" FontStyle="Italic" Foreground="#FFA9A9A9" VerticalContentAlignment="Center" HorizontalAlignment="Left" TextChanged="Label_TextChanged" />
    <StackPanel Grid.Column="1">
      <vb:ExpressionTextBox Name="VbBox" HintText="Enter the case condition" UseLocationExpression="False" ExpressionType="{x:Type sys:Boolean}" />
    </StackPanel>
    <Button Name="ETBButton" Grid.Column="2" Width="20" Click="ETBButton_Click">...</Button>
    <Button Name="DeleteButton" Grid.Column="3" Width="20" BorderThickness="0" BorderBrush="#FFFFFFFF" Background="#FFFFFFFF" Click="DeleteButton_Click">X</Button>
  </Grid>
</UserControl>