<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Autodesk.SubassemblyComposer.ActivityLibrary.UserControls.VariableValueCtrl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:vb="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation" xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation" xmlns:local="clr-namespace:Autodesk.SubassemblyComposer.ActivityLibrary.UserControls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Name="TextColumn" Width="*" />
      <ColumnDefinition Name="ExpressionBoxColumn" Width="*" />
      <ColumnDefinition Name="WarngingColumn" Width="16" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
        <TextBox Name="Text_Box" BorderThickness="0" BorderBrush="#FFFFFFFF" Background="#FFFFFFFF" FontStyle="Italic" Foreground="#FFA9A9A9" VerticalContentAlignment="Center" LostFocus="Text_Box_LostFocus" />
    <StackPanel Grid.Column="1">
      <vb:ExpressionTextBox Name="VB_Box" HintText="Enter a VB expression" UseLocationExpression="False" ExpressionType="{x:Type sys:Boolean}" />
    </StackPanel>
    <Image Grid.Column="2" Source="/Subassembly.ActivityLibrary;component/Resources/exclamation_point.ico" Width="16" Height="16" />
    <Button Name="ETBButton" Grid.Column="3" Width="20" Click="ETBButton_Click">...</Button>
  </Grid>
</UserControl>