<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Autodesk.SubassemblyComposer.ActivityLibrary.UserControls.ExpressionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:vb="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Expression Editor" Height="180" Width="360" xmlns:usercontrols="clr-namespace:Autodesk.SubassemblyComposer.ActivityLibrary.UserControls;assembly=Subassembly.ActivityLibrary" KeyUp="Window_KeyUp">
  <UIElement.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Help" Executed="OnHelp" />
  </UIElement.CommandBindings>
  <Grid Background="#FFF0F8FF">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" MinWidth="50" />
      <ColumnDefinition Width="70" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="70" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="70" />
      <ColumnDefinition Width="8" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="4" />
      <RowDefinition Height="25" />
      <RowDefinition Height="*" />
      <RowDefinition Height="8" />
      <RowDefinition Height="23" />
      <RowDefinition Height="6" />
    </Grid.RowDefinitions>
    <vb:ExpressionTextBox Name="VBExpressionBox" Grid.Column="1" Grid.ColumnSpan="6" Grid.Row="2" MaxLines="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalAlignment="Stretch" />
    <Button Name="ButtonOK" Grid.Column="2" Grid.Row="4" Click="Button_Click">OK me</Button>
    <Button Name="ButtonCancel" Grid.Column="4" Grid.Row="4" Click="Button_Click">Cancel</Button>
    <Button Name="ButtonHelp" Grid.Column="6" Grid.Row="4" Click="OnHelp">Help</Button>
  </Grid>
</Window>